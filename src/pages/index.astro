---
import Layout from '../layouts/Layout.astro';
import Knot from '../components/Knot.astro';
import Diagram from '../components/Diagram.astro';
import Paper from '../components/Paper.astro';
import { getCollection } from 'astro:content';
import publications from '../data/publications.json';
import { site } from '../data/site';
import { url } from '../lib/paths';
const research=(await getCollection('research')).sort((a,b)=>a.data.number.localeCompare(b.data.number));
const news=(await getCollection('news')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<Layout>
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">FUDAN UNIVERSITY / THEORETICAL PHYSICS</p><h1>Quantum geometry<br/>&amp; information</h1><p>Quantum gravity, topological quantum field theory, and quantum machine learning at Fudan University.</p><div class="hero-actions"><a class="button white" href={url('research/')}>Research <span aria-hidden="true">↗</span></a><a class="button outline-light" href={url('publications/')}>Publications <span aria-hidden="true">↗</span></a></div></div><Knot/></div><div class="hero-fields"><div class="container">{site.fields.map(field=><span>{field}</span>)}</div></div></section>
<section class="container intro-band"><div><p class="eyebrow">THE MARCIANÒ RESEARCH GROUP</p><h2>Theoretical physics<br/>at Fudan University</h2></div><div><p>We are a theoretical physics research group led by Prof. Antonino Marcianò at Fudan University in Shanghai. Our interests meet at the intersection of quantum geometry, quantum information, quantum gravity, and quantum machine learning.</p><a class="text-link" style="margin-top:20px" href={url('people/')}>Group members <span aria-hidden="true">↗</span></a></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">01 / RESEARCH DIRECTIONS</span><h2>Research directions</h2></div><p>Topological and geometric methods in quantum theory.</p></div><div class="research-grid">{research.map(item=><a class="research-card" href={url(`research/#${item.id}`)}><div class="card-top"><span>{item.data.number}</span><span aria-hidden="true">↗</span></div><Diagram kind={item.data.diagram}/><h3>{item.data.title}</h3><p>{item.data.summary}</p></a>)}<div class="research-card"><p class="eyebrow">RELATED AREAS</p><h3>Geometry &amp; topology</h3><p>Mathematical structures connecting our research directions.</p><a class="text-link" href={url('research/')}>Research overview <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section selected-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">02 / SELECTED PUBLICATIONS</span><h2>Selected publications</h2></div><a class="text-link" href={url('publications/')}>View publications <span aria-hidden="true">↗</span></a></div>{publications.filter(p=>p.featured).map(paper=><Paper paper={paper} summary/>)}</div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">03 / NEWS & EVENTS</span><h2>News & events</h2></div><a class="text-link" href={url('news/')}>News & events <span aria-hidden="true">↗</span></a></div><div class="news-grid">{news.map(item=><article class="news-card"><div class="meta"><span>{item.data.kind.toUpperCase()}</span><time datetime={item.data.date}>{new Date(`${item.data.date}T12:00:00Z`).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</time></div><h3><a href={url(`news/#${item.id}`)}>{item.data.title}</a></h3><p>{item.data.summary}</p><a class="text-link" href={url(`news/#${item.id}`)}>Read more <span aria-hidden="true">↗</span></a></article>)}</div></section>

</Layout>
