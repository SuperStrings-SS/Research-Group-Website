---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/site';
---
<Layout title="Join the group"><div class="page-heading"><div class="container"><p class="eyebrow">JOIN & COLLABORATE</p><h1>Join the group</h1><p>Research enquiries, doctoral and postdoctoral opportunities, and academic visits.</p></div></div><section class="section container two-column"><div class="join-copy"><h2>Research opportunities</h2><p>Prospective students and collaborators can explore our research and contact Prof. Marcianò through his university email.</p>{[['Doctoral research','For enquiries about doctoral research in topological field theory and quantum information, contact the group with your background and research interests.'],['Postdoctoral research','Contact the group about research in quantum geometry and quantum learning, and the availability of funded positions.'],['Visits & collaboration','Researchers working in related areas are welcome to enquire about visits and collaboration.']].map(([title,text])=><article class="opportunity"><h3>{title}</h3><p>{text}</p></article>)}</div><aside class="join-side"><h3>Enquiries</h3><ol><li>Read a few papers that connect to your interests.</li><li>Introduce your background and the questions you would like to explore.</li><li>For formal positions, follow the confirmed university application instructions when available.</li></ol><a class="button blue" href={`mailto:${site.email}`}>Email Prof. Marcianò ↗</a><p class="muted" style="font-size:.78rem;margin-top:18px">An inquiry does not replace a formal application.</p></aside></section></Layout>
