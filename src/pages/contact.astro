---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/site';
---
<Layout title="Contact & Visit" active="Contact"><div class="page-heading"><div class="container"><p class="eyebrow">CONTACT & VISIT</p><h1>Contact & visit</h1><p>Get in touch about our research, prospective collaboration, or a visit to the group.</p></div></div><section class="section container two-column"><div class="contact-card"><p class="eyebrow">ANTONINO MARCIANÒ RESEARCH GROUP</p><h2>Fudan University</h2><p>Department of Physics<br/>Fudan University<br/>Shanghai, China</p><p><a class="text-link" href={`mailto:${site.email}`}>{site.email} ↗</a></p><p><a href={site.faculty}>University faculty profile ↗</a><br/><a href={site.scholar}>Google Scholar ↗</a></p></div><div class="contact-details"><h2>Planning a visit</h2><dl><dt>Institution</dt><dd>Fudan University / 复旦大学<br/>Department of Physics / 物理学系</dd><dt>Building & office</dt><dd>Physics Research Building, Room S201<br/>物理科研楼 S201 室</dd><dt>Campus & street address</dt><dd>Please contact the group for directions.</dd><dt>Local time</dt><dd>Shanghai · China Standard Time (UTC+8)</dd></dl><p class="note">Please arrange visits with the group by email.</p></div></section></Layout>
