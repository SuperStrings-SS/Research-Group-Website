---
import Layout from '../layouts/Layout.astro';
import {url} from '../lib/paths';
---
<Layout title="Page not found"><section class="section container"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1 style="margin-block:20px">A path not yet mapped.</h1><p class="muted">This page does not exist, or its address has changed.</p><a class="button blue" style="margin-top:30px" href={url()}>Return to the homepage ↗</a></section></Layout>
