---
const { kind = 'network', large = false } = Astro.props;
---
<svg class:list={['science-diagram', {large}]} viewBox="0 0 320 180" fill="none" aria-hidden="true">
  {kind === 'cobordism' && <g stroke="currentColor" stroke-width="1.3"><path d="M126 30C126 72 112 83 73 126M194 30C194 72 208 83 247 126M160 81C139 91 139 115 139 139M160 81C181 91 181 115 181 139"/><ellipse cx="160" cy="30" rx="34" ry="10"/><ellipse cx="105" cy="133" rx="35" ry="12" transform="rotate(14 105 133)"/><ellipse cx="215" cy="133" rx="35" ry="12" transform="rotate(-14 215 133)"/><path d="M139 38C142 77 113 91 91 122M153 40C154 65 154 73 160 81M181 38C178 77 207 91 229 122" opacity=".35"/><path d="M129 56Q160 72 191 56M120 79Q145 90 160 81Q175 90 200 79M100 103L141 117M220 103L179 117" opacity=".35"/></g>}
  {(kind === 'network' || kind === 'learning') && <g stroke="currentColor" stroke-width="1.2"><path d="M58 90L105 35L205 35L261 90L205 145L105 145ZM105 35L125 90L105 145M205 35L190 90L205 145M58 90H261M125 90L205 35M190 90L105 145" opacity=".65"/>{[[58,90],[105,35],[205,35],[261,90],[205,145],[105,145],[125,90],[190,90]].map(([cx,cy])=><circle cx={cx} cy={cy} r="4" fill="currentColor" stroke="none"/>)}{kind==='learning' && <g opacity=".4"><path d="M30 40V140M290 40V140M20 90H58M261 90H300"/><circle cx="30" cy="40" r="3"/><circle cx="290" cy="140" r="3"/></g>}</g>}
  {kind === 'surface' && <g stroke="currentColor" stroke-width=".9">{Array.from({length:9},(_,i)=><path d={`M${40+i*8} ${115-i*8}Q160 ${25+i*10} ${216+i*8} ${60+i*9}`} opacity={.3+i*.07}/>)}{Array.from({length:10},(_,i)=><path d={`M${40+i*20} ${115-28*Math.sin(i/3)}Q${80+i*18} ${155-i*11} ${104+i*20} ${51+12*Math.sin(i/2)}`} opacity=".6"/>)}</g>}
  {kind === 'circuit' && <g stroke="currentColor" stroke-width="1.3"><path d="M40 50H280M40 90H280M40 130H280M160 50V130M235 90V130" opacity=".65"/><rect x="75" y="35" width="30" height="30" fill="var(--diagram-bg, #f4f6fb)"/><rect x="110" y="75" width="30" height="30" fill="var(--diagram-bg, #f4f6fb)"/><circle cx="160" cy="50" r="4" fill="currentColor"/><circle cx="160" cy="130" r="11"/><circle cx="235" cy="90" r="4" fill="currentColor"/><circle cx="235" cy="130" r="11"/><text x="90" y="55" text-anchor="middle" stroke="none" fill="currentColor" font-size="14">H</text><text x="125" y="95" text-anchor="middle" stroke="none" fill="currentColor" font-size="14">U</text></g>}
</svg>
